{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "app-skills index",
  "type": "object",
  "required": ["repo", "apps"],
  "properties": {
    "repo": { "type": "string" },
    "updated": { "type": "string", "description": "YYYY-MM-DD" },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "package", "platform", "path", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "name": { "type": "string" },
          "package": { "type": "string" },
          "platform": { "enum": ["android", "ios", "harmony", "web", "other"] },
          "vendor": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "version_tested": { "type": "string" },
          "verified": { "type": "string" },
          "status": { "enum": ["verified", "draft", "broken"] },
          "risk": { "enum": ["low", "medium", "high"] },
          "author": { "type": "string" },
          "path": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
